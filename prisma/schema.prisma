// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  // provider = "prisma-client-js" // v6 -> v7
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL") // v6 -> v7
}

model User {
  id          Int      @id @default(autoincrement())
  updatedAt   DateTime @updatedAt
  username    String   @unique
  email       String   @unique
  image       String
  guildMember Boolean?
  exams       Exam[]

  @@unique([username, email], name: "identifier")
}

model Exam {
  id         Int      @id @default(autoincrement())
  name       String
  courseCode String?
  startDate  DateTime
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
}

model F1PagesData {
  id    Int     @id @default(autoincrement())
  page  String
  title String
  link  String?
}
